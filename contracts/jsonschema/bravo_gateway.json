  "so.line.cancel@1": {
    "$defs": {
      "LineRef": {
        "additionalProperties": false,
        "description": "One SO line as DW read it: the document, the line, and the line's\nrowversion when the PIC saw it. A line changed since is refused. The\nheader's rowversion is not carried: Bravo rewrites the header on every\nsave of any line, so an approval bound to it would be spent by a\ncolleague's save on another line; the gateway holds the header's\ncondition from its own read, as the client does from its load.",
        "properties": {
          "line_id": {
            "title": "Line Id",
            "type": "integer"
          },
          "line_rowversion": {
            "title": "Line Rowversion",
            "type": "string"
          },
          "so_id": {
            "title": "So Id",
            "type": "integer"
          }
        },
        "required": [
          "so_id",
          "line_id",
          "line_rowversion"
        ],
        "title": "LineRef",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "description": "A write: The whole line cancelled (`IsCancel`); a partial cancel is a split,",
    "properties": {
      "content": {
        "additionalProperties": false,
        "description": "The whole line cancelled (`IsCancel`); a partial cancel is a split,\nthen this on the part that goes (ticket 53). What the client writes for a\ncancel is not yet traced (the 11-20 trace holds only a cancel cleared), so\nthe gateway refuses this kind until it is (`WriteKind.pending`).",
        "properties": {
          "line": {
            "$ref": "#/$defs/LineRef"
          }
        },
        "required": [
          "line"
        ],
        "title": "CancelLine",
        "type": "object"
      },
      "kind": {
        "const": "so.line.cancel"
      },
      "version": {
        "const": 1
      }
    },
    "required": [
      "content",
      "kind",
      "version"
    ],
    "type": "object"
  },
