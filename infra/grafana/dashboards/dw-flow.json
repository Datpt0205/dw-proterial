{
  "uid": "dw-flow",
  "title": "DW · Luồng việc",
  "description": "Hàng đợi việc, việc bị thu hồi, lỗi theo bước.",
  "tags": [
    "dw"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "1m",
  "panels": [
    {
      "type": "text",
      "title": "",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "Việc đi qua hàng đợi (outbox) giữa các bước. Hàng đợi tăng mãi là worker không xử lý kịp hoặc đang lỗi."
      },
      "id": 1
    },
    {
      "type": "timeseries",
      "title": "Việc đang chờ trong outbox",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "dw_outbox_backlog_size",
          "legendFormat": "đang chờ"
        }
      ],
      "id": 2
    },
    {
      "type": "timeseries",
      "title": "Tuổi việc chờ lâu nhất",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 3,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "dw_outbox_oldest_pending_age_seconds",
          "legendFormat": "giây"
        }
      ],
      "id": 3
    },
    {
      "type": "timeseries",
      "title": "Việc bị thu hồi do worker chết giữa chừng (mỗi giờ)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 11,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (queue) (increase(dw_reaper_reaped_total[1h]))",
          "legendFormat": "{{queue}}"
        }
      ],
      "id": 4
    },
    {
      "type": "timeseries",
      "title": "Lỗi theo bước (mỗi 15 phút)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 11,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (worker, node, error_type) (increase(dw_node_failure_total[15m]))",
          "legendFormat": "{{worker}} · {{node}} · {{error_type}}"
        }
      ],
      "id": 5
    }
  ]
}
