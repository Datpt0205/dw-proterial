{
  "uid": "dw-health",
  "title": "DW · Sức khỏe hệ thống",
  "description": "Tiến trình nào đang chạy, cảnh báo nào đang bật, lỗi gần nhất.",
  "tags": [
    "dw"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "1m",
  "panels": [
    {
      "type": "text",
      "title": "",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "Mỗi ô là một tiến trình. **DỪNG** quá 2 phút là có cảnh báo (Alertmanager). Lỗi chi tiết: bảng log cuối trang, hoặc Explore → Loki."
      },
      "id": 1
    },
    {
      "type": "stat",
      "title": "API",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 4,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DỪNG",
                  "color": "red"
                },
                "1": {
                  "text": "CHẠY",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "textMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"dw-api\"}",
          "legendFormat": "API",
          "instant": true
        }
      ],
      "id": 2
