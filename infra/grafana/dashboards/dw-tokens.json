{
  "uid": "dw-tokens",
  "title": "DW · Token",
  "description": "Tải lên model: token vào, ra.",
  "tags": [
    "dw"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "1m",
  "panels": [
    {
      "type": "text",
      "title": "",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "Token vào và ra của model trên máy chủ nhà máy. Không có chi phí API (model chạy tại chỗ); token cho biết tải trên GPU."
      },
      "id": 1
    },
    {
      "type": "timeseries",
      "title": "Token mỗi phút, theo chiều",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (direction) (rate(dw_model_tokens_total[5m])) * 60",
          "legendFormat": "{{direction}}"
        }
      ],
      "id": 2
    },
    {
      "type": "timeseries",
      "title": "Token trong 24 giờ, theo model",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 3,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (model, direction) (increase(dw_model_tokens_total[24h]))",
          "legendFormat": "{{model}} · {{direction}}"
        }
      ],
      "id": 3
    },
    {
      "type": "timeseries",
      "title": "Token trung bình mỗi lần gọi",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 11,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(dw_model_tokens_total[15m])) / sum(rate(dw_model_calls_total[15m]))",
          "legendFormat": "token / lần"
        }
      ],
      "id": 4
    }
  ]
}
